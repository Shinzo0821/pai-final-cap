# Move above the peg, then descend to insert.
above = target.copy()
above[2] += 0.20
goto_pose(above, handle_quat)
goto_pose(target, handle_quat, z_approach=0.15)

# Release and retreat.
open_gripper()
goto_pose(above, handle_quat)
goto_home_joint_position()


