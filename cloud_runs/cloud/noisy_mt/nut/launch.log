import numpy as np

def avg_pos(fn, name, n=10):
    ps = []
    q = None
    for _ in range(n):
        p, qq = fn(name)
        ps.append(np.asarray(p, dtype=float))
        if q is None:
            q = np.asarray(qq, dtype=float)
    return np.mean(ps, axis=0), q

# --- check current state: is the nut already on the peg? ---
nut_center_pos, _ = avg_pos(get_object_pose, "white hollow center of the brown square nut")
peg_pos, _ = avg_pos(get_object_pose, "brown square block")
xy_err = np.linalg.norm(nut_center_pos[:2] - peg_pos[:2])
print("nut center:", nut_center_pos, "peg:", peg_pos, "xy error:", xy_err)

if xy_err > 0.02:
    # nut not on peg: redo the grasp-and-insert with a better final height
    goto_home_joint_position()
