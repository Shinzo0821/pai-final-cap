    # Average several perception calls to reduce ~1 cm noise
    ps = []
    q0 = None
    for _ in range(n):
        p, q = fn(name)
        ps.append(np.asarray(p, dtype=float))
        if q0 is None:
            q0 = np.asarray(q, dtype=float)
    return np.mean(ps, axis=0), q0

