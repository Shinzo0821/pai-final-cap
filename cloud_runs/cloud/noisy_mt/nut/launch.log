# Code block 0
import numpy as np

def avg_pos(fn, name, n=10):
    # average several noisy perception calls to reduce ~1 cm error
    ps = []
    q = None
    for _ in range(n):
        p, qq = fn(name)
        ps.append(np.asarray(p, dtype=float))
        if q is None:
            q = np.asarray(qq, dtype=float)
    return np.mean(ps, axis=0), q

goto_home_joint_position()
open_gripper()

# perceive nut center, handle grasp and the peg (block)
nut_center_pos, _ = avg_pos(get_object_pose, "white hollow center of the brown square nut")
grasp_pos, grasp_quat = avg_pos(sample_grasp_pose, "extruded handle of the brown square nut")
peg_pos, _ = avg_pos(get_object_pose, "brown square block")

# rigid offset from nut center to handle grasp point (world frame, orientation is kept during transport)
offset = grasp_pos - nut_center_pos

# grasp the handle: approach from above, descend, close
goto_pose(grasp_pos, grasp_quat, z_approach=0.10)
close_gripper()

# lift straight up
lift_pos = grasp_pos.copy()
lift_pos[2] += 0.15
goto_pose(lift_pos, grasp_quat)

# target: nut center aligned with peg axis, keep same grasp orientation
target_grasp_pos = peg_pos + offset
# keep hover height, move horizontally over the peg
hover_pos = target_grasp_pos.copy()
hover_pos[2] = lift_pos[2]
goto_pose(hover_pos, grasp_quat)

# descend onto the peg; final z such that nut sits down at the block/peg base height
insert_pos = target_grasp_pos.copy()
insert_pos[2] = peg_pos[2] + offset[2] + 0.005
goto_pose(insert_pos, grasp_quat, z_approach=0.08)

# release and retreat
open_gripper()
retreat_pos = insert_pos.copy()
retreat_pos[2] += 0.15
goto_pose(retreat_pos, grasp_quat)
goto_home_joint_position()

