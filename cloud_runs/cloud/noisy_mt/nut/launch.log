import numpy as np

def avg_pose(fn, name, n=10):
    ps, q = [], None
    for _ in range(n):
        p, q = fn(name)
        ps.append(p)
    return np.mean(ps, axis=0), q

# Perceive the nut (center and handle); average to reduce ~1cm noise.
nut_center_pos, _ = avg_pose(get_object_pose, "white hollow center of the brown square nut")
handle_pos, handle_quat = avg_pose(sample_grasp_pose, "extruded handle of the brown square nut")

# Rigid offset from nut center to handle grasp point (world frame; orientation is kept fixed).
offset = handle_pos - nut_center_pos

