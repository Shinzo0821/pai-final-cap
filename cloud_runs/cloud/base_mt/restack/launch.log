goto_pose(place_pos, grasp_quat, z_approach=0.1)

# Release the red cube only once it is resting on the green cube
open_gripper()

# Retreat upward
retreat_pos = place_pos.copy()
retreat_pos[2] += 0.1
goto_pose(retreat_pos, grasp_quat)


